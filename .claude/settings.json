{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/usage-audit-reminder.mjs",
            "timeout": 10,
            "statusMessage": "Checking whether an agent-doc audit is needed"
          }
        ]
      }
    ]
  }
}
